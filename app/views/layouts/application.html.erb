<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Sath Gym" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "css-zero/reset", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "css-zero/variables", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "css-zero/utilities", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="">
    <% if user_signed_in? %>
      <div class="sidebar-layout">
        <aside id="sidebar">
          <%= render "layouts/partials/sidebar_menu" %>
        </aside>
        <main id="main">
          <%= render "layouts/partials/mobile_menu" %>
          <div>
            <div class="flex justify-between">
              <%= render "layouts/partials/breadcrumbs" %>
              <%= render "layouts/partials/notification" %>
            </div>
          <%= yield %>
          </div>
        </main>
      </div>
    <% else %>
      <main class="centered-layout login-bg">
        <%= yield %>
      </main>
    <% end %>
  </body>
</html>
