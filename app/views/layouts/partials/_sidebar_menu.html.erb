<div class="sidebar-menu">
  <%= link_to "#", class: "btn sidebar-menu__button disabled" do %>
    <div class="flex shrink-0 overflow-hidden rounded-lg bg-black text-reversed">
      <span class="icon icon--gallery-vertical-end m-2"></span>
    </div>
    <div class="flex flex-col text-start leading-tight overflow-hidden">
      <span class="overflow-ellipsis font-semibold">Sath Gym</span>
      <span class="overflow-ellipsis text-xs hidden">Enterprise</span>
    </div>
    <span class="icon icon--chevrons-up-down mis-auto" aria-hidden="true"></span>
  <% end %>
  <div class="sidebar-menu__content">
    <div class="sidebar-menu__group">
      <div class="sidebar-menu__group-label">Platform</div>
      <div class="sidebar-menu__items">
        <%= nav_link_to root_path, class: "btn sidebar-menu__button" do %>
          <span class="icon icon--chart-pie" aria-hidden="true"></span>
          <span class="overflow-ellipsis">Dashboard</span>
        <% end %>
        <details <%= "open" if gym_goers_menu_open? %>>
          <summary class="btn sidebar-menu__button">
            <span class="icon icon--id-card-lanyard" aria-hidden="true"></span>
            <span class="overflow-ellipsis">Gym-goers</span>
          </summary>
          <nav class="sidebar-menu__sub">
            <%= nav_link_to "Attendance", attendances_path, class: "btn sidebar-menu__button" %>
            <%= nav_link_to "Members", members_path, class: "btn sidebar-menu__button" %>
            <%= nav_link_to "Product & Plans", products_path, class: "btn sidebar-menu__button" %>
          </nav>
        </details>
        <details <%= "open" if payment_menu_open? %> >
          <summary class="btn sidebar-menu__button">
            <span class="icon icon--wallet" aria-hidden="true"></span>
            <span class="overflow-ellipsis">Payments</span>
          </summary>
          <nav class="sidebar-menu__sub">
            <%= nav_link_to "Transaction", transactions_path, class: "btn sidebar-menu__button" %>
            <%= nav_link_to "Renewal", "#", class: "btn sidebar-menu__button" %>
            <%= nav_link_to "Invoice", "#", class: "btn sidebar-menu__button" %>
          </nav>
        </details>
        <%= nav_link_to equipments_path, class: "btn sidebar-menu__button" do %>
          <span class="icon icon--dumbbells" aria-hidden="true"></span>
          <span class="overflow-ellipsis">Equipments</span>
        <% end %>
      </div>
    </div>
    <div class="sidebar-menu__group">
      <div class="sidebar-menu__group-label">AI Assistance</div>
      <nav class="sidebar-menu__items">
        <%= link_to "#", class: "btn sidebar-menu__button" do %>
          <span class="icon icon--hexagon" aria-hidden="true"></span>
          <span class="overflow-ellipsis">Social Media</span>
        <% end %>
        <%= nav_link_to chats_path, class: "btn sidebar-menu__button" do %>
          <span class="icon icon--bot-message-square" aria-hidden="true"></span>
          <span class="overflow-ellipsis">Chatbot</span>
        <% end %>
      </nav>
    </div>
  </div>
  <div class="mbs-auto">
    <div contents data-controller="popover" data-popover-placement-value="top-start">
      <button class="btn sidebar-menu__button" data-popover-target="trigger" popovertarget="popover" aria-haspopup="true">
        <div class="flex shrink-0 overflow-hidden rounded-lg">
          <%= image_tag "zoom.jpg", size: 32, alt: "CN" %>
        </div>
        <div class="flex flex-col text-start leading-tight overflow-hidden">
          <span class="overflow-ellipsis max-i-full font-semibold capitalize"><%= current_user.fullname %></span>
          <span class="overflow-ellipsis max-i-full text-xs"><%= current_user.role %></span>
        </div>
        <span class="icon icon--chevrons-up-down mis-auto" aria-hidden="true"></span>
      </button>

      <div popover id="popover" class="popover" style="--popover-size: 15rem;" data-popover-target="content" role="menu" aria-label="Menu">
        <div class="menu">
          <%= link_to destroy_user_session_path, class: "btn menu__item !text-red-500", data: { menu_target: "item", turbo_method: :delete }, role: "menuitem" do %>
            <span class="icon icon--log-out" aria-hidden="true"></span>
            <span class="overflow-ellipsis">Sign out</span>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>