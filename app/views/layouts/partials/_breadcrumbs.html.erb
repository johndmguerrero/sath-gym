<nav class="breadcrumb mbe-5" aria-label="Breadcrumb">
  <%= breadcrumbs.map.with_index do |item, index|
    if index == breadcrumbs.length - 1
      content_tag(:span, item.name, class: "text-primary", aria: { current: "page", disabled: "true" }, role: "link")
    else
      link_to(item.name, send("#{item.path}"))
    end
  end.join(breadcrumbs_divider).html_safe %>
</nav>
