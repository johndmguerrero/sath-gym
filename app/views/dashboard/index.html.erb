<div>
  <!-- Welcome Header -->
  <div class="flex justify-between items-center mb-8">
    <div>
      <h1 class="text-3xl font-bold text-primary mb-1">Welcome, <%= current_user.fullname %></h1>
      <p class="text-sm text-secondary">Here's what's happening with your gym today</p>
    </div>
    <div data-controller="clock" class="text-right">
      <div data-clock-target="time" class="text-2xl font-bold text-primary"></div>
      <div data-clock-target="date" class="text-sm text-secondary"></div>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
      <!-- Total Members Card -->
      <div class="stat-card card text-white" style="background-color: var(--color-crusta-500)">
          <div>
              <div class="stat-label">Total Members</div>
              <div class="text-2xl font-bold"><%= @total_members %></div>
              <div class="text-xs mbs-2">
                <%= @active_members.size %> active, <%= @draft_members.size %> inactive
              </div>
          </div>
      </div>

      <!-- Today's Attendance Card -->
      <div class="stat-card card text-white" style="background-color: var(--color-crusta-500)">
          <div>
              <div class="stat-label">Today's Check-ins</div>
              <div class="text-2xl font-bold"><%= @today_attendance_count %></div>
              <div class="text-xs mbs-2">Last 24 hours: <%= @recent_attendances.size %></div>
          </div>
      </div>

      <!-- Expiring Soon Card -->
      <div class="stat-card card text-white" style="background-color: var(--color-crusta-500)">
          <div>
              <div class="stat-label">Membership Expiring Soon</div>
              <div class="text-2xl font-bold"><%= @expiring_soon.size %></div>
              <div class="text-xs mbs-2">Next 30 days</div>
          </div>
      </div>

      <!-- Revenue Card -->
      <div class="stat-card card text-white" style="background-color: var(--color-crusta-500)">
          <div>
              <div class="stat-label">Monthly Revenue</div>
              <div class="text-2xl font-bold">₱<%= number_with_delimiter(@monthly_revenue.to_i) %></div>
              <div class="text-xs mbs-2">Today: ₱<%= number_with_delimiter(@today_revenue.to_i) %></div>
          </div>
      </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
    <div class="relative i-full" style="block-size: 400px;">
      <%= tag.canvas aria: { label: "Monthly Sales" }, role: "img", data: { controller: "chart", chart_type_value: "line", chart_data_value: @chart_data.to_json } %>
    </div>
    <div class="relative i-full" style="block-size: 350px;">
      <%= tag.canvas class: "m-auto" ,aria: { label: "Most Popular Plans" }, role: "img", data: { controller: "chart", chart_type_value: "pie", chart_data_value: @pie_data.to_json } %>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Recent Attendance -->
      <div class="lg:col-span-2">
          <div class="card">
              <div class="flex justify-between items-center mbe-3">
                  <h2 style="font-size: 20px; font-weight: 600; margin: 0;">Recent Attendance</h2>
                  <span class="time-badge">Last 24 Hours</span>
              </div>

              <div class="list">
                <% if @recent_attendances.any? %>
                  <% @recent_attendances.each_with_index do |attendance, index| %>
                    <%
                      initials = attendance.user.first_name[0..0].upcase + attendance.user.last_name[0..0].upcase
                    %>
                    <%= link_to edit_member_path(id: attendance.user.customer_number), class: "list-row list-row--link flex items-center justify-between" do %>
                      <div class="flex flex-col gap-half">
                        <h5 class="text-sm leading-none font-medium"><%= attendance.user.fullname %></h5>
                        <p class="text-sm text-subtle">Check-in: <%= attendance.created_at.strftime("%I:%M %p") %></p>
                      </div>
                      <span class="icon icon--chevron-right" aria-hidden="true"></span>
                    <% end %>
                  <% end %>
                <% else %>
                  <div class="text-center p-8 text-subtle">
                    <p>No recent check-ins in the last 24 hours</p>
                  </div>
                <% end %>
              </div>

              <% if @recent_attendances.any? %>
                <div class="mbs-4 pbs-4 border-t text-center">
                  <%= link_to attendances_path, class: "btn btn--sm" do %>
                    View All Attendance
                    <span class="icon icon--chevron-right" aria-hidden="true"></span>
                  <% end %>
                </div>
              <% end %>
          </div>
      </div>

      <!-- Expiring Memberships -->
      <div>
          <div class="card">
              <div class="flex justify-between items-center mbe-3">
                  <h2 style="font-size: 20px; font-weight: 600; margin: 0;">Membership Expiring Soon</h2>
                  <span class="time-badge">Next 30 Days</span>
              </div>

              <div class="list">
                  <% if @expiring_soon.any? %>
                    <% @expiring_soon.each do |subscription| %>
                      <%
                        days_until_expiry = ((subscription.expires_at.to_date - Date.current).to_i)
                        badge_class = if days_until_expiry <= 7
                          "badge-danger"
                        elsif days_until_expiry <= 14
                          "badge-warning"
                        else
                          "badge-info"
                        end
                        border_color = if days_until_expiry <= 7
                          "var(--danger)"
                        elsif days_until_expiry <= 14
                          "var(--warning)"
                        else
                          "var(--info)"
                        end
                      %>
                        <%= link_to edit_member_path(id: subscription.user.customer_number), class: "list-row list-row--link flex items-center justify-between" do %>
                          <div class="flex flex-col gap-half">
                            <h5 class="text-sm leading-none font-medium"><%= subscription.user.fullname %></h5>
                            <p class="text-sm text-subtle">Expires <%= subscription.expires_at.strftime("%b %d, %Y") %></p>
                          </div>
                          <span class="badge <%= badge_class %>"><%= days_until_expiry %> Days</span>
                        <% end %>
                    <% end %>
                  <% else %>
                    <div class="text-center p-8 text-subtle">
                      <p>No memberships expiring in the next 30 days</p>
                    </div>
                  <% end %>
              </div>

              <% if @expiring_soon.any? %>
                <div class="mbs-4 pbs-4 border-t text-center">
                  <%= link_to members_path, class: "btn btn--sm" do %>
                    View All Members
                    <span class="icon icon--chevron-right" aria-hidden="true"></span>
                  <% end %>
                </div>
              <% end %>
          </div>
      </div>
  </div>
</div>
