<div>
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
      <!-- Total Members Card -->
      <div class="stat-card card">
          <div>
              <div class="stat-label">Total Members</div>
              <div class="stat-value"><%= @total_members %></div>
              <div class="text-xs text-subtle mbs-2">
                <%= @active_members.size %> active, <%= @draft_members.size %> draft
              </div>
          </div>
      </div>

      <!-- Today's Attendance Card -->
      <div class="stat-card card">
          <div>
              <div class="stat-label">Today's Check-ins</div>
              <div class="stat-value"><%= @today_attendance_count %></div>
              <div class="text-xs text-subtle mbs-2">Last 24 hours: <%= @recent_attendances.size %></div>
          </div>
      </div>

      <!-- Expiring Soon Card -->
      <div class="stat-card card">
          <div>
              <div class="stat-label">Expiring Soon</div>
              <div class="stat-value"><%= @expiring_soon.size %></div>
              <div class="text-xs text-subtle mbs-2">Next 30 days</div>
          </div>
      </div>

      <!-- Revenue Card -->
      <div class="stat-card card">
          <div>
              <div class="stat-label">Monthly Revenue</div>
              <div class="stat-value">₱<%= number_with_delimiter(@monthly_revenue.to_i) %></div>
              <div class="text-xs text-subtle mbs-2">Today: ₱<%= number_with_delimiter(@today_revenue.to_i) %></div>
          </div>
      </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Recent Attendance -->
      <div class="lg:col-span-2">
          <div class="card">
              <div class="flex justify-between items-center mb-6">
                  <h2 style="font-size: 20px; font-weight: 600; margin: 0;">Recent Attendance</h2>
                  <span class="time-badge">Last 24 Hours</span>
              </div>

              <div class="space-y-0">
                  <% if @recent_attendances.any? %>
                    <% @recent_attendances.each_with_index do |attendance, index| %>
                      <%
                        colors = [
                          "linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%)",
                          "linear-gradient(135deg, #ec4899 0%, #f59e0b 100%)",
                          "linear-gradient(135deg, #06b6d4 0%, #10b981 100%)",
                          "linear-gradient(135deg, #a78bfa 0%, #ec4899 100%)",
                          "linear-gradient(135deg, #f59e0b 0%, #ef4444 100%)"
                        ]
                        gradient = colors[index % colors.length]
                        initials = attendance.user.first_name[0..0].upcase + attendance.user.last_name[0..0].upcase
                      %>
                      <div class="table-row">
                          <div class="member-info">
                              <div class="avatar" style="">
                                <span role="img"><%= initials %></span>
                              </div>
                              <div class="member-details">
                                  <h3><%= attendance.user.fullname %></h3>
                                  <p>Check-in: <%= attendance.created_at.strftime("%I:%M %p") %></p>
                              </div>
                          </div>
                          <% if attendance.remarks.present? %>
                            <div style="text-align: right;">
                                <p style="font-size: 14px; margin: 0; color: var(--accent);"><%= attendance.remarks %></p>
                            </div>
                          <% end %>
                      </div>
                    <% end %>
                  <% else %>
                    <div class="text-center p-8 text-subtle">
                      <p>No recent check-ins in the last 24 hours</p>
                    </div>
                  <% end %>
              </div>

              <% if @recent_attendances.any? %>
                <div class="mbs-4 pbs-4 border-t text-center">
                  <%= link_to attendances_path, class: "btn btn--sm" do %>
                    View All Attendance
                    <span class="icon icon--arrow-right" aria-hidden="true"></span>
                  <% end %>
                </div>
              <% end %>
          </div>
      </div>

      <!-- Expiring Memberships -->
      <div>
          <div class="card">
              <div class="flex justify-between items-center mb-6">
                  <h2 style="font-size: 20px; font-weight: 600; margin: 0;">Expiring Soon</h2>
                  <span class="time-badge">Next 30 Days</span>
              </div>

              <div class="space-y-4">
                  <% if @expiring_soon.any? %>
                    <% @expiring_soon.each do |subscription| %>
                      <%
                        days_until_expiry = ((subscription.expires_at.to_date - Date.current).to_i)
                        badge_class = if days_until_expiry <= 7
                          "badge-danger"
                        elsif days_until_expiry <= 14
                          "badge-warning"
                        else
                          "badge-info"
                        end
                        border_color = if days_until_expiry <= 7
                          "var(--danger)"
                        elsif days_until_expiry <= 14
                          "var(--warning)"
                        else
                          "var(--info)"
                        end
                      %>
                      <div style="padding: 12px; background-color: var(--bg-darker); border-radius: 8px; border-left: 3px solid <%= border_color %>;">
                          <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                              <div>
                                  <%= link_to edit_member_path(subscription.user.customer_number), class: "text-decoration-none", data: { turbo_frame: "_top" } do %>
                                    <p style="margin: 0; font-size: 14px; font-weight: 600; color: var(--text-primary);"><%= subscription.user.fullname %></p>
                                  <% end %>
                                  <p style="margin: 4px 0 0 0; font-size: 12px; color: var(--text-secondary);">
                                    Expires <%= subscription.expires_at.strftime("%b %d, %Y") %>
                                  </p>
                              </div>
                              <span class="badge <%= badge_class %>"><%= days_until_expiry %> Days</span>
                          </div>
                      </div>
                    <% end %>
                  <% else %>
                    <div class="text-center p-8 text-subtle">
                      <p>No memberships expiring in the next 30 days</p>
                    </div>
                  <% end %>
              </div>

              <% if @expiring_soon.any? %>
                <div class="mbs-4 pbs-4 border-t text-center">
                  <%= link_to members_path, class: "btn btn--sm" do %>
                    View All Members
                    <span class="icon icon--arrow-right" aria-hidden="true"></span>
                  <% end %>
                </div>
              <% end %>
          </div>
      </div>
  </div>
</div>
