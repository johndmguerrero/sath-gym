<div class="attendances">
  <div class="page-title mbe-5 flex items-center gap-4">
    <div class="page-title-btn-wrapper">
      <%= link_to "",  class: "btn", data: { controller: "back-navigation", back_navigation_fallback_destination_value: dashboard_index_path }  do %>
        <span class="icon icon--chevron-left" aria-hidden="true"></span>
        Back
      <% end %>
    </div>
    <h2 class="text-2xl">Manage Attendance</h2>
  </div>

  <%= link_to "http://127.0.0.1:5000/start", target: "_blank", class: "btn btn--primary" do %>
    Face scan
  <% end %>

    <div class="relative i-full overflow-x-auto border rounded-lg mbe-4">
      <table class="table" data-controller="check-all">
        <%= render partial: "attendances/partials/table_header", locals: { attendances: @attendances } %>
        <%= render partial: "attendances/partials/table_body", locals: { attendances: @attendances } %>
      </table>
    </div>


</div>