<div class="index-product">
  <div class="page-title mbe-5 flex items-center gap-4">
    <div class="page-title-btn-wrapper">
      <%= link_to "",  class: "btn", data: { controller: "back-navigation", back_navigation_fallback_destination_value: dashboard_index_path }  do %>
        <span class="icon icon--arrow-left" aria-hidden="true"></span>
        Back
      <% end %>
    </div>
    <h2 class="text-2xl">Manage Subscriptions</h2>
    <div class="quick-action mis-auto">
      <%= link_to new_product_path, class: "btn btn--primary" do %>
        Add Subscription <span class="icon icon--calendar-sync" aria-hidden="true"></span>
      <% end %>
    </div>
  </div>
  <div class="grid grid-cols-1 gap-4 lg:grid-cols-3 lg:gap-6">
    <% @products.each do |product| %>
      <%= render "products/product_card", product: product %>
    <% end %>
  </div>

</div>