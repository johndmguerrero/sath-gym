<div hidden id="tab_membership" data-tabs-target="tab" role="tabpanel" aria-labelledby="trigger_membership">

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div class="card">
      <h3 class="mbe-3">Membership Information</h3>

      <% if @member.subscription.present? %>
        <div>
          <div class="grid grid-cols-2">
            <dt>Product</dt>
            <dd><%= @member.subscription.product_plan.product.name %></dd>
          </div>

          <div class="grid grid-cols-2">
            <dt>Plan</dt>
            <dd>₱ <%= humanized_money(@member.subscription.product_plan.price_cents) %></dd>
          </div>

          <div class="grid grid-cols-2">
            <dt>Status</dt>
            <dd><%= @member.subscription.status.titleize %></dd>
          </div>

          <div class="grid grid-cols-2">
            <dt>Expires At</dt>
            <dd><%= @member.subscription.expires_at.strftime("%B %d, %Y") if @member.subscription.expires_at %></dd>
          </div>
        </div>
      <% else %>
        <p>No active subscription</p>
      <% end %>
    </div>

  </div>
</div>