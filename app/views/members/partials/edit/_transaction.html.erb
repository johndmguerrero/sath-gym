<div hidden id="tab_transactions" data-tabs-target="tab" role="tabpanel" aria-labelledby="trigger_transactab_transactions">
  <div class="card">
    <div class="card-header mbe-3">
      <div class="flex items-center justify-between">
        <div>
          <h5 class="font-semibold">Transaction History</h5>
          <p class="text-sm text-subtle">All transactions for this member's subscription</p>
        </div>
      </div>
    </div>

    <% if @member.subscription.present? && @member.subscription.transactions.any? %>
      <div class="table-container">
        <table class="table">
          <thead>
            <tr>
              <th>Date</th>
              <th>Type</th>
              <th>Payment Method</th>
              <th class="text-right">Total</th>
              <th class="text-right">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @member.subscription.transactions.order(created_at: :desc).each do |transaction| %>
              <tr>
                <td class="whitespace-nowrap"><%= transaction.created_at.strftime("%b %d, %Y %I:%M %p") %></td>
                <td class="whitespace-nowrap">
                  <% if transaction.renewal? %>
                    <span class="badge badge--success">Renewal</span>
                  <% else %>
                    <span class="badge badge--primary">Checkout</span>
                  <% end %>
                </td>
                <td class="whitespace-nowrap">
                  <span class="badge badge--<%= transaction.payment_method %>">
                    <%= transaction.payment_method.titleize.gsub('_', ' ') %>
                  </span>
                </td>
                <td class="whitespace-nowrap text-right font-medium"><%= transaction.total.format %></td>
                <td class="whitespace-nowrap text-right">
                  <% if transaction.renewal? %>
                    <%= link_to show_renewal_transactions_path(customer_number: @member.customer_number, id: transaction.id),
                        class: "btn btn--secondary btn--small" do %>
                      <span class="icon icon--eye" aria-hidden="true"></span>
                      View
                    <% end %>
                  <% else %>
                    <%= link_to show_checkout_transactions_path(customer_number: @member.customer_number, id: transaction.id),
                        class: "btn btn--secondary btn--small" do %>
                      <span class="icon icon--eye" aria-hidden="true"></span>
                      View
                    <% end %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="text-center py-8">
        <span class="icon icon--receipt text-gray-400" aria-hidden="true" style="--icon-size: 3rem"></span>
        <p class="text-subtle mt-2">No transactions yet</p>
        <% if @member.subscription.present? %>
          <p class="text-sm text-gray-500 mt-1">Transactions will appear here after checkout or renewal.</p>
        <% else %>
          <p class="text-sm text-gray-500 mt-1">This member needs a subscription first.</p>
        <% end %>
      </div>
    <% end %>
  </div>
</div>