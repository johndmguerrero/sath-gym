<div hidden id="tab_attendance" data-tabs-target="tab" role="tabpanel" aria-labelledby="trigger_account">
  <div class="card">
    <h3>Attendance History</h3>

    <% if @member.attendances.any? %>
      <table>
        <thead>
          <tr>
            <th>Date</th>
            <th>Time</th>
            <th>Remarks</th>
          </tr>
        </thead>
        <tbody>
          <% @member.attendances.order(created_at: :desc).limit(10).each do |attendance| %>
            <tr>
              <td><%= attendance.created_at.strftime("%B %d, %Y") %></td>
              <td><%= attendance.created_at.strftime("%I:%M %p") %></td>
              <td><%= attendance.remarks %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p>No attendance records</p>
    <% end %>
  </div>
</div>