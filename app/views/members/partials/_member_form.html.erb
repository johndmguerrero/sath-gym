  <%= form_with url: members_path, html: { autocomplete: "off" }, model: member, id: "register-member", data: { controller: "form" } do |f| %>
    <% if member.errors.any? %>
      <div class="alert alert--error mbe-5">
        <div class="alert-header">
          <span class="icon icon--circle-exclamation" aria-hidden="true"></span>
          <strong><%= pluralize(member.errors.count, "error") %> prohibited this member from being saved:</strong>
        </div>
        <ul class="mbs-2">
          <% member.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="card personal-information mbe-5">
      <div class="card-header mbe-3">
        <div class="flex items-center gap-2 mbe-2">
          <span class="icon icon--id-card-lanyard" aria-hidden="true" style="--icon-size: 1.25rem"></span>
          <h4 class="text-xl">
            Personal Information
          </h4>
        </div>
        <p class="text-subtle">Basic details about the member</p>
      </div>
      <div class="separator mb-4" aria-hidden="true"></div>
      <div class="grid gap-4 grid-cols-1 lg:grid-cols-3 mbe-3">
        <div class="form-first-name">
          <%= f.label :first_name, class: "mbe-2 block required" %>
          <%= f.text_field :first_name, class: "input #{'input--error' if member.errors[:first_name].any?}" %>
          <% if member.errors[:first_name].any? %>
            <span class="text-error text-sm"><%= member.errors[:first_name].first %></span>
          <% end %>
        </div>
        <div class="form-last-name">
          <%= f.label :last_name, class: "mbe-2 block required" %>
          <%= f.text_field :last_name, class: "input #{'input--error' if member.errors[:last_name].any?}" %>
          <% if member.errors[:last_name].any? %>
            <span class="text-error text-sm"><%= member.errors[:last_name].first %></span>
          <% end %>
        </div>
        <div class="form-nickname">
          <%= f.label :nickname, class: "mbe-2 block" %>
          <%= f.text_field :nickname, class: "input" %>
        </div>
      </div>
      <div class="grid gap-4 grid-cols-1 lg:grid-cols-4 mbe-3">
        <div class="form-email lg:col-span-2">
          <%= f.label :email, class: "mbe-2 block required" %>
          <%= f.email_field :email, class: "input #{'input--error' if member.errors[:email].any?}" %>
          <% if member.errors[:email].any? %>
            <span class="text-error text-sm"><%= member.errors[:email].first %></span>
          <% end %>
        </div>
        <div class="form-phone-number">
          <%= f.label :phone_number, class: "mbe-2 block required" %>
          <%= f.text_field :phone_number, class: "input #{'input--error' if member.errors[:phone_number].any?}" %>
          <% if member.errors[:phone_number].any? %>
            <span class="text-error text-sm"><%= member.errors[:phone_number].first %></span>
          <% end %>
        </div>
        <div class="form-gender">
          <%= f.label :gender, class: "mbe-2 block required" %>
          <%= f.collection_select :gender, genders, :to_s, :humanize, {}, { class: "input #{'input--error' if member.errors[:gender].any?}" } %>
          <% if member.errors[:gender].any? %>
            <span class="text-error text-sm"><%= member.errors[:gender].first %></span>
          <% end %>
        </div>
      </div>
      <div class="grid gap-4 grid-cols-1 lg:grid-cols-4 mbe-3">
        <div class="form-date-of-birth">
          <%= f.label :date_of_birth, class: "mbe-2 block required" %>
          <%= f.text_field :date_of_birth, class: "input #{'input--error' if member.errors[:date_of_birth].any?}", placeholder: "Pick members birthday", data: { controller: "datepicker", datepicker_min_age_value: 18 } %>
          <% if member.errors[:date_of_birth].any? %>
            <span class="text-error text-sm"><%= member.errors[:date_of_birth].first %></span>
          <% end %>
        </div>
      </div>
    </div>

    <div class="card address mbe-5">
      <div class="card-header mbe-3">
        <div class="flex items-center gap-2 mbe-2">
          <span class="icon icon--id-card-lanyard" aria-hidden="true" style="--icon-size:1.25rem"></span>
          <h4 class="text-xl">
            Personal Address
          </h4>
        </div>
        <p class="text-subtle">Person address</p>

      </div>
      <div class="separator mb-4" aria-hidden="true"></div>

      <%= f.fields_for :user_address do |address_form| %>
        <div class="grid gap-4 grid-cols-1 lg:grid-cols-3 mbe-3" data-controller="address">
          <div class="form-region">
            <%= address_form.label :region, class: "mbe-2 block" %>
            <%= select_tag "region_code",
                [],
                {
                  id: 'region',
                  class: 'form-control input',
                  data: {
                    address_target: "region",
                    action: "change->address#fillProvinces"
                  }
                }

            %>
            <%= address_form.hidden_field :region,
                id: 'region-text',
                data: { address_target: "regionText" }
            %>
          </div>
          <div class="form-province">
            <%= address_form.label :province, class: "mbe-2 block" %>
            <%= select_tag "province_code",
                [],
                {
                  id: 'province',
                  class: 'form-control input',
                  data: {
                    address_target: "province",
                    action: "change->address#fillCities"
                  }
                }

            %>
            <%= address_form.hidden_field :province,
                id: 'province-text',
                data: { address_target: "provinceText" }
            %>
          </div>
          <div class="form-city">
            <%= address_form.label :city, class: "mbe-2 block" %>
            <%= select_tag "city_code",
                [],
                {
                  id: 'city',
                  class: 'form-control input',
                  data: {
                    address_target: "city",
                    action: "change->address#fillBarangays"
                  }
                }

            %>
            <%= address_form.hidden_field :city,
                id: 'city-text',
                data: { address_target: "cityText" }
            %>
          </div>
          <div class="form-barangay">
            <%= address_form.label :barangay, class: "mbe-2 block" %>
            <%= select_tag "barangay_code",
                [],
                {
                  id: 'barangay',
                  class: 'form-control input',
                  data: {
                    address_target: "barangay",
                    action: "change->address#updateBarangayText"
                  }
                }

            %>
            <%= address_form.hidden_field :barangay,
                id: 'barangay-text',
                data: { address_target: "barangayText" }
            %>
          </div>
        </div>
      <% end %>
    </div>

    <div class="card health-information mbe-5 hidden">
      <div class="card-header mbe-3">
        <div class="flex items-center gap-2 mbe-2">
          <span class="icon icon--diameter" aria-hidden="true" style="--icon-size: 1.25rem"></span>
          <h4 class="text-xl">
            Physical Measurements
          </h4>
        </div>
        <p class="text-subtle">Body metrics for personalized training programs</p>
      </div>
      <div class="separator mb-4" aria-hidden="true"></div>
      <div class="grid gap-4 grid-cols-1 lg:grid-cols-2 mbe-3">
        <div class="form-weight">
          <%= f.label :weight, class: "mbe-2 block" %>
          <%= f.number_field :weight, class: "input" %>
        </div>
        <div class="form-height">
          <%= f.label :height, class: "mbe-2 block" %>
          <%= f.number_field :height, class: "input" %>
        </div>
      </div>
    </div>

    <div class="card membership-information mbe-5">
      <div class="card-header mbe-3">
        <div class="flex items-center gap-2 mbe-2">
          <span class="icon icon--id-card" aria-hidden="true" style="--icon-size: 1.25rem"></span>
          <h4 class="text-xl">
            Membership Information
          </h4>
        </div>
        <p class="text-subtle">Choose the plan that fits your needs</p>
      </div>
      <div class="separator mb-4" aria-hidden="true"></div>
      <%= f.fields_for :subscription do |sub| %>
        <div class="grid gap-4 grid-cols-1 lg:grid-cols-2 mbe-3">
          <div class="form-weight">
            <%= f.label :product, class: "mbe-2 block" %>
            <%= f.collection_select :product_id, @products, :id, :name, { include_blank: "Select one" } ,{ class: "input", data: { action: "form#submit", form_submitter_param: "on_subscription_change" } } %>
          </div>
          <div class="form-height">
            <%= sub.label :product_plan_id, class: "mbe-2 block" %>
            <%= sub.collection_select :product_plan_id, [], :id, :name, { include_blank: "Select one" }, { class: "input" } %>
          </div>
        </div>
      <% end %>
    </div>

    <div class="flex form-actions">
      <div class="mis-auto flex gap-4">
        <%= link_to "",  class: "btn btn--borderless", data: { controller: "back-navigation", back_navigation_fallback_destination_value: dashboard_index_path }  do %>
          Cancel
        <% end %>
        <%= f.button "Register Member", type: "submit", class: "btn btn--primary btn--busy" %>
        <%= f.submit id: "on_subscription_change", hidden: true, formaction: on_subscription_change_members_path, formmethod: :post, formnovalidate: true %>
      </div>
    </div>

  <% end %>