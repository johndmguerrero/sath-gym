<div class="edit_member" data-controller="tabs">
  <div class="border-be border-gray-200">
    <div class="tabs !flex-row gap-7" role="tablist">

      <div class="btn--wrapper">
        <button class="btn btn--plain btn--tabs-plain" type="button"
                id="trigger_information" data-tabs-target="button" data-action="tabs#select" role="tab" aria-selected="true" aria-controls="tab_information"
        >
          <span class="icon icon--id-card-lanyard" aria-hidden="true"></span>
          <span>Information</span>
        </button>
      </div>

      <div class="btn--wrapper">
        <button class="btn btn--plain btn--tabs-plain" type="button"
                id="trigger_membership" data-tabs-target="button" data-action="tabs#select" role="tab" aria-controls="tab_membership"
        >
          <span class="icon icon--id-card" aria-hidden="true"></span>
          <span>Membership</span>
        </button>
      </div>

      <div class="btn--wrapper">
        <button class="btn btn--plain btn--tabs-plain" type="button"
                id="trigger_attendance" data-tabs-target="button" data-action="tabs#select" role="tab" aria-controls="tab_attendance"
        >
          <span class="icon icon--calendar-days" aria-hidden="true"></span>
          <span>Attendance</span>
        </button>
      </div>

      <div class="btn--wrapper">
        <button class="btn btn--plain btn--tabs-plain" type="button"
                id="trigger_settings" data-tabs-target="button" data-action="tabs#select" role="tab" aria-controls="tab_settings"
        >
          <span class="icon icon--user-cog" aria-hidden="true"></span>
          <span>Settings</span>
        </button>
      </div>
    </div>
  </div>

  <div class="tab_member-content pb-3">
    <%= render "members/partials/edit/information", locals: { member: @member } %>
    <%= render "members/partials/edit/membership", locals: { member: @member } %>
    <%= render "members/partials/edit/attendance", locals: { member: @member } %>
    <%= render "members/partials/edit/settings", locals: { member: @member } %>
  </div>
</div>