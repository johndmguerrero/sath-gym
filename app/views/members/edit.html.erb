<div class="edit_member" data-controller="tabs">

  <div class="page-title mbe-5 flex items-center gap-4 items-center">
    <div class="page-title-btn-wrapper">
      <%= link_to "",  class: "btn btn--icon", data: { controller: "back-navigation", back_navigation_fallback_destination_value: dashboard_index_path }  do %>
        <span class="icon icon--chevron-left" aria-hidden="true"></span>

      <% end %>
    </div>
    <h2 class="text-3xl"><%= @member.fullname %></h2>
    <p class="text-subtle"> Last activty <%= @member.updated_at %></p>

    <div class="mis-auto">
      <button class="btn btn--secondary">Renew</button>
    </div>
  </div>

  <%= render partial: "members/partials/edit/members-content", locals: { member: @member} %>

  <%= render "members/partials/edit/member-tab" %>
  <div class="tab_member-content pb-3">
    <%= render "members/partials/edit/information", locals: { member: @member } %>
    <%= render "members/partials/edit/membership", locals: { member: @member } %>
    <%= render "members/partials/edit/attendance", locals: { member: @member } %>
    <%= render "members/partials/edit/settings", locals: { member: @member } %>
  </div>
</div>