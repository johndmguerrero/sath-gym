<div class="checkout-content">
  <div class="card">
    <div class="card-header mbe-3">
      <div class="flex items-center gap-2 mbe-2">
        <span class="icon icon--wallet-card" aria-hidden="true" style="--icon-size: 1.25rem"></span>
        <h4 class="text-xl">
          Checkout
        </h4>
      </div>
      <p class="text-subtle">Complete the subscription payment</p>
    </div>

        <!-- Subscription Details -->
    <div class="space-y-4 mb-6">
      <div class="mbe-3">
        <label class="">Subscription Name</label>
        <input
          type="text"
          id="subscriptionName"
          class="input"
          value="Premium Plan"
        >
      </div>

      <div class="mbe-3"">
        <label class="">Subscription Cost</label>
        <input
            type="number"
            id="subscriptionCost"
            class="input"
            placeholder="0.00"
            value="29.99"
            step="0.01"
            min="0"
            oninput="calculateChange()"
          >
      </div>
    </div>
  </div>
</div>