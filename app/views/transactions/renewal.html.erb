<div data-controller="print">
<%= form_with(model: @transaction, url: renewal_transactions_path(customer_number: @user.customer_number, renewal: true), local: true) do |form| %>
  <% if @transaction.errors.any? %>
    <div class="alert alert--negative mbe-5" role="alert">
      <div class="flex items-start gap-3">
        <span class="icon icon--exclamation-triangle" aria-hidden="true"></span>
        <div class="flex-1">
          <h4 class="font-semibold mbe-2">
            <%= pluralize(@transaction.errors.count, "error") %> prohibited this renewal from being completed:
          </h4>
          <ul class="list-disc pis-4">
            <% @transaction.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>
  <% end %>

  <div class="card">
    <div class="card-header mbe-3">
      <div class="flex items-center gap-2 mbe-2">
        <span class="icon icon--wallet-card" aria-hidden="true" style="--icon-size: 1.25rem"></span>
        <h4 class="text-xl">Subscription Renewal</h4>
      </div>
      <p class="text-subtle">Renew the subscription for <%= @user.fullname %></p>
    </div>

    <div class="separator mb-4" aria-hidden="true"></div>

    <!-- Member Information -->
    <section class="mbe-5">
      <h5 class="font-semibold mbe-3">Member Information</h5>
      <div class="grid gap-3 grid-cols-1 lg:grid-cols-2">
        <div>
          <label class="text-sm text-gray-600">Customer Number</label>
          <div class="input bg-gray-100 text-gray-800" style="cursor: not-allowed;">
            <%= @user.customer_number %>
          </div>
        </div>
        <div>
          <label class="text-sm text-gray-600">Member Name</label>
          <div class="input bg-gray-100 text-gray-800" style="cursor: not-allowed;">
            <%= @user.fullname %>
          </div>
        </div>
        <div>
          <label class="text-sm text-gray-600">Email</label>
          <div class="input bg-gray-100 text-gray-800" style="cursor: not-allowed;">
            <%= @user.email %>
          </div>
        </div>
        <div>
          <label class="text-sm text-gray-600">Phone</label>
          <div class="input bg-gray-100 text-gray-800" style="cursor: not-allowed;">
            <%= @user.phone_number %>
          </div>
        </div>
      </div>
    </section>

    <div class="separator mb-4" aria-hidden="true"></div>

    <!-- Subscription Details -->
    <section class="mbe-5">
      <h5 class="font-semibold mbe-3">Subscription Details</h5>
      <div class="grid gap-3 grid-cols-1 lg:grid-cols-2">
        <div>
          <label class="text-sm text-gray-600">Product</label>
          <div class="input bg-gray-100 text-gray-800" style="cursor: not-allowed;">
            <%= @user.subscription.product_plan.product.name %>
          </div>
        </div>
        <div>
          <label class="text-sm text-gray-600">Plan</label>
          <div class="input bg-gray-100 text-gray-800" style="cursor: not-allowed;">
            <%= @user.subscription.product_plan.interval.humanize %> - <%= number_to_currency(@user.subscription.product_plan.price_cents / 100.0, unit: "₱") %>
          </div>
        </div>
        <div>
          <label class="text-sm text-gray-600">Current Expiration Date</label>
          <div class="input bg-gray-100 text-gray-800" style="cursor: not-allowed;">
            <%= @user.subscription.expires_at.strftime("%B %d, %Y") %>
          </div>
        </div>
        <div>
          <label class="text-sm text-gray-600">New Expiration Date (After Renewal)</label>
          <div class="input bg-blue-50 text-blue-800 font-semibold" style="cursor: not-allowed;">
            <%
              current_expiration = @user.subscription.expires_at
              plan = @user.subscription.product_plan
              new_expiration = case plan.interval
                when "daily"
                  current_expiration + (plan.interval_count || 1).days
                when "monthly"
                  current_expiration + (plan.interval_count || 1).months
                when "yearly"
                  current_expiration + (plan.interval_count || 1).years
                else
                  current_expiration + 1.month
                end
            %>
            <%= new_expiration.strftime("%B %d, %Y") %>
          </div>
        </div>
        <div>
          <label class="text-sm text-gray-600">Plan Price</label>
          <div class="input bg-gray-100 text-gray-800 font-semibold" style="cursor: not-allowed;">
            <%= number_to_currency(@user.subscription.product_plan.price_cents / 100.0, unit: "₱") %>
          </div>
        </div>
      </div>
    </section>

    <div class="separator mb-4" aria-hidden="true"></div>

    <!-- Payment Information -->
    <section class="mbe-5">
      <h5 class="font-semibold mbe-3">Payment Information</h5>

      <div class="grid gap-4 grid-cols-1 lg:grid-cols-2 mbe-3">
        <div class="form-payment-method col-span-2 lg:col-span-1">
          <%= form.label :payment_method, "Payment Method" %>
          <%= form.select :payment_method,
              Transaction.payment_methods.keys.map { |k| [k.humanize.titleize, k] },
              { prompt: "Select payment method" },
              { class: "input", required: true } %>
          <p class="text-xs text-gray-500 mt-1">How will the member pay?</p>
        </div>

        <div class="form-reference col-span-2 lg:col-span-1">
          <%= form.label :reference_number, "Reference Number (Optional)" %>
          <%= form.text_field :reference_number, placeholder: "e.g. TXN123456789", class: "input" %>
          <p class="text-xs text-gray-500 mt-1">Transaction reference or receipt number</p>
        </div>

        <div class="form-subtotal col-span-2 lg:col-span-1">
          <%= form.label :subtotal_cents, "Subtotal (in cents)" %>
          <div class="input-group">
            <%= form.number_field :subtotal_cents,
                value: @user.subscription.product_plan.price_cents,
                placeholder: "0",
                class: "input",
                min: 0,
                step: 1,
                required: true %>
            <span class="input-addon">PHP</span>
          </div>
          <p class="text-xs text-gray-500 mt-1">Amount before taxes/fees (in centavos)</p>
        </div>

        <div class="form-total col-span-2 lg:col-span-1">
          <%= form.label :total_cents, "Total Amount (in cents)" %>
          <div class="input-group">
            <%= form.number_field :total_cents,
                value: @user.subscription.product_plan.price_cents,
                placeholder: "0",
                class: "input",
                min: 0,
                step: 1,
                required: true %>
            <span class="input-addon">PHP</span>
          </div>
          <p class="text-xs text-gray-500 mt-1">Final amount including taxes/fees (in centavos)</p>
        </div>

        <div class="form-paying-amount col-span-2 lg:col-span-1">
          <%= form.label :paying_amount_cents, "Amount Paid (in cents)" %>
          <div class="input-group">
            <%= form.number_field :paying_amount_cents,
                value: @user.subscription.product_plan.price_cents,
                placeholder: "0",
                class: "input",
                min: 0,
                step: 1,
                required: true %>
            <span class="input-addon">PHP</span>
          </div>
          <p class="text-xs text-gray-500 mt-1">Amount received from customer (in centavos)</p>
        </div>

        <div class="form-remarks col-span-2">
          <%= form.label :remarks, "Remarks (Optional)" %>
          <%= form.text_area :remarks, rows: 3, placeholder: "Add any notes about this renewal...", class: "input" %>
          <p class="text-xs text-gray-500 mt-1">Internal notes or special instructions</p>
        </div>
      </div>

      <!-- Amount Summary -->
      <div class="card bg-gray-50 mbe-3">
        <h6 class="font-semibold mbe-2">Payment Summary</h6>
        <div class="space-y-2 text-sm">
          <div class="flex justify-between">
            <span class="text-gray-600">Subtotal:</span>
            <span class="font-medium" id="display-subtotal">₱ 0.00</span>
          </div>
          <div class="flex justify-between">
            <span class="text-gray-600">Total:</span>
            <span class="font-medium" id="display-total">₱ 0.00</span>
          </div>
          <div class="separator my-2" aria-hidden="true"></div>
          <div class="flex justify-between">
            <span class="text-gray-600">Amount Paid:</span>
            <span class="font-semibold" id="display-paying">₱ 0.00</span>
          </div>
          <div class="flex justify-between">
            <span class="text-gray-600">Change:</span>
            <span class="font-semibold text-green-600" id="display-change">₱ 0.00</span>
          </div>
        </div>
      </div>
    </section>

    <div class="separator mb-4" aria-hidden="true"></div>

    <div class="flex form-actions">
      <button type="button"
              class="btn btn--secondary print-button"
              data-action="click->print#print"
              aria-label="Print receipt">
        <span class="icon icon--printer" aria-hidden="true"></span>
        Print
      </button>
      <div class="mis-auto flex gap-4">
        <%= link_to "Cancel", edit_member_path(@user.customer_number), class: "btn btn--secondary" %>
        <%= form.submit "Complete Renewal Payment", class: "btn btn--primary" %>
      </div>
    </div>
  </div>
<% end %>
</div>

<script>
  // Update display amounts in real-time
  document.addEventListener('DOMContentLoaded', function() {
    const subtotalInput = document.querySelector('[name="transaction[subtotal_cents]"]');
    const totalInput = document.querySelector('[name="transaction[total_cents]"]');
    const payingInput = document.querySelector('[name="transaction[paying_amount_cents]"]');

    function formatCurrency(amount) {
      return '₱ ' + amount.toLocaleString('en-PH', {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
      });
    }

    function updateDisplays() {
      const subtotal = parseFloat(subtotalInput?.value || 0) / 100;
      const total = parseFloat(totalInput?.value || 0) / 100;
      const paying = parseFloat(payingInput?.value || 0) / 100;
      const change = paying - total;

      // Update display elements with formatted currency
      const displaySubtotal = document.getElementById('display-subtotal');
      const displayTotal = document.getElementById('display-total');
      const displayPaying = document.getElementById('display-paying');
      const displayChange = document.getElementById('display-change');

      if (displaySubtotal) displaySubtotal.textContent = formatCurrency(subtotal);
      if (displayTotal) displayTotal.textContent = formatCurrency(total);
      if (displayPaying) displayPaying.textContent = formatCurrency(paying);
      if (displayChange) displayChange.textContent = formatCurrency(change);

      // Highlight change in red if negative, green if positive
      if (displayChange) {
        if (change < 0) {
          displayChange.classList.remove('text-green-600');
          displayChange.classList.add('text-red-600');
        } else {
          displayChange.classList.remove('text-red-600');
          displayChange.classList.add('text-green-600');
        }
      }

      // Visual feedback: highlight the payment summary card if there's insufficient payment
      const summaryCard = document.querySelector('.card.bg-gray-50');
      if (summaryCard) {
        if (change < 0) {
          summaryCard.classList.remove('bg-gray-50');
          summaryCard.classList.add('bg-red-50', 'border', 'border-red-200');
        } else {
          summaryCard.classList.remove('bg-red-50', 'border', 'border-red-200');
          summaryCard.classList.add('bg-gray-50');
        }
      }
    }

    // Attach event listeners to all inputs
    if (subtotalInput) subtotalInput.addEventListener('input', updateDisplays);
    if (totalInput) totalInput.addEventListener('input', updateDisplays);
    if (payingInput) payingInput.addEventListener('input', updateDisplays);

    // Also listen for 'change' event (for manual entry completion)
    if (subtotalInput) subtotalInput.addEventListener('change', updateDisplays);
    if (totalInput) totalInput.addEventListener('change', updateDisplays);
    if (payingInput) payingInput.addEventListener('change', updateDisplays);

    // Initial update on page load
    updateDisplays();
  });
</script>
