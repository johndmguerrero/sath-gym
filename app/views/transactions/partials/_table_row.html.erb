<tr id="transaction_<%= transaction.id %>">
  <td class="whitespace-nowrap"><%= transaction.created_at.strftime("%b %d, %Y %I:%M %p") %></td>
  <td class="whitespace-nowrap">
    <span class="text-subtle"><%= transaction.subscription.user.fullname %></span>
  </td>
  <td class="whitespace-nowrap">
    <span class="badge badge--<%= transaction.transaction_type %>">
      <%= transaction.transaction_type.titleize %>
    </span>
  </td>
  <td class="whitespace-nowrap">
    <span class="badge badge--<%= transaction.payment_method %>">
      <%= transaction.payment_method.titleize.gsub('_', ' ') %>
    </span>
  </td>
  <td class="whitespace-nowrap text-right font-medium"><%= transaction.total.format %></td>
</tr>
